APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ammar_be_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Tripay (payment gateway QRIS) ---
# Daftar & ambil kredensial sandbox di https://tripay.co.id/member (menu Merchant > Opsi)
TRIPAY_BASE_URL=https://tripay.co.id/api-sandbox
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
# Kode channel pembayaran, mis. QRIS / QRISC / QRIS2 (lihat daftar di dashboard Tripay)
TRIPAY_PAYMENT_METHOD=QRIS
# Lama waktu bayar sebelum kedaluwarsa (menit)
TRIPAY_EXPIRY_MINUTES=15
# Halaman tujuan setelah bayar, mis. https://domain-frontend.vercel.app/payment
TRIPAY_RETURN_URL=

# --- Firebase Authentication (login Google customer) ---
# Project ID dari Firebase Console > Project settings > General
FIREBASE_PROJECT_ID=

# --- Fonnte (kirim struk pesanan lewat WhatsApp) ---
# Token device dari https://md.fonnte.com (menu Device; device harus berstatus connected)
FONNTE_BASE_URL=https://api.fonnte.com
FONNTE_TOKEN=
