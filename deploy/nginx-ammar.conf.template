# Nginx untuk backend Ammar (Laravel). __DOMAIN__ diganti oleh server-setup.sh.
# Sertifikat HTTPS ditambahkan otomatis oleh Certbot.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root /var/www/ammar-be/public;
    index index.php;

    client_max_body_size 10m;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # SSE kasir & dapur: jangan di-buffer, dan beri waktu baca lebih panjang dari
    # durasi satu koneksi (STAFF_STREAM_DURATION, default 25 detik).
    # Jangan pakai snippets/fastcgi-php.conf di sini: isinya `try_files $fastcgi_script_name =404`
    # sehingga URL non-.php seperti ini dijawab 404. Cukup fastcgi_params + index.php Laravel.
    location = /api/v1/stream/orders {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/ammar.sock;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_buffering off;
        fastcgi_read_timeout 75s;
        gzip off;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/ammar.sock;
        fastcgi_read_timeout 60s;
    }

    # file tersembunyi (.env, .git, dll) tidak boleh diakses
    location ~ /\.(?!well-known).* {
        deny all;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    access_log /var/log/nginx/ammar-access.log;
    error_log  /var/log/nginx/ammar-error.log;
}
