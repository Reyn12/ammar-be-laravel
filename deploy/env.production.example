# Template .env produksi. Salin ke /var/www/ammar-be/.env di server, lalu isi nilai yang kosong.
# JANGAN commit .env asli. APP_KEY dan DB_PASSWORD diisi otomatis oleh server-setup.sh.

APP_NAME="Ammar Backend"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__DOMAIN__
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ammar_be_laravel
DB_USERNAME=ammar
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=sync

SANCTUM_TOKEN_EXPIRATION=43200

# SSE kasir & dapur
STAFF_STREAM_DURATION=25
STAFF_STREAM_INTERVAL_MS=1000
STAFF_STREAM_HEARTBEAT=15

# Firebase Authentication (login Google customer)
FIREBASE_PROJECT_ID=ammar-ayam-bakar

# Tripay - ganti ke https://tripay.co.id/api dan kredensial production saat go-live
TRIPAY_BASE_URL=https://tripay.co.id/api-sandbox
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_PAYMENT_METHOD=QRIS
TRIPAY_EXPIRY_MINUTES=15
TRIPAY_RETURN_URL=https://ammar-fe-nextjs.vercel.app/payment

# Fonnte (WhatsApp)
FONNTE_BASE_URL=https://api.fonnte.com
FONNTE_TOKEN=

# Alamat web customer (Next.js), untuk isi QR meja
CUSTOMER_APP_URL=https://ammar-fe-nextjs.vercel.app
